# Optional — Phase 1 scraping.
# Without this, Phase 1 serves the seeded demo data (12 Bandra dentists).
# Phases 2-5 run using OpenRouter (requires OPENROUTER_API_KEY).
#
# Get a free token at https://apify.com (Settings → API tokens)
APIFY_TOKEN=
APIFY_ACTOR=compass~crawler-google-places

# Advanced (optional): override which OpenRouter model the phases use.
# CLAUDE_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=
